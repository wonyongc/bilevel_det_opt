#!/bin/bash
#SBATCH -A m4956_g
#SBATCH -C gpu
#SBATCH -q regular
#SBATCH -N 1
#SBATCH -G 1
#SBATCH -c 32
#SBATCH -t 02:00:00
#SBATCH -J escan_warpx
#SBATCH -o /pscratch/sd/s/sapta/bilevel/escan/slurm/warpx_%x_%j.log
# One WarpX beam-beam run at one FCC-ee working point.
#   POINT  : Z | WW | ZH | tt
#   PRESET : test | prod              (default test)
#   EXTRA  : extra options for make_deck.py, e.g. "--merge-channels"
set -u
: "${POINT:?set POINT to Z|WW|ZH|tt}"
PRESET=${PRESET:-test}
EXTRA=${EXTRA:-}
CODE=$HOME/bilevel_det_opt/bilevel_opt/mdi/escan
BASE=/pscratch/sd/s/sapta/bilevel/escan
WORK=$BASE/$PRESET
WX=$HOME/src/warpx/build/bin/warpx.3d.MPI.CUDA.DP.PDP.OPMD.FFT.EB.QED.GENQEDTABLES
TABLE=$BASE/qs_table_chimin1e-7.bin

[ -x "$WX" ] || { echo "missing WarpX binary $WX"; exit 1; }
mkdir -p $WORK && cd $WORK || exit 1
# The photon-emission table is generated by the first run and reused afterwards.
if [ -s "$TABLE" ]; then TMODE=load; else TMODE=generate; fi
python3 $CODE/make_deck.py $POINT --preset $PRESET --qs-table $TABLE --qs-table-mode $TMODE $EXTRA || exit 1

source $HOME/perlmutter_gpu_warpx.profile
cd $WORK/$POINT || exit 1
rm -rf diags Backtrace.*
echo "=== start $(date) POINT=$POINT PRESET=$PRESET table=$TMODE ==="
srun -n 1 -G 1 $WX inputs > warpx.log 2>&1
rc=$?
echo "=== done $(date) rc=$rc ==="
grep "Avg. per step" warpx.log | tail -1
grep -i "abort\|error" warpx.log | head -5
[ $rc -eq 0 ] && [ -d diags/scrape1 ] || { echo "RUN FAILED - see $WORK/$POINT/warpx.log"; tail -20 warpx.log; exit 1; }
